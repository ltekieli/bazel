module(
    name = "example_override",
    version = "0.0.0",
)

bazel_dep(name = "lib_a", version = "0.0.0")
local_path_override(
    module_name = "lib_a",
    path = "../lib_a",
)

bazel_dep(name = "lib_b", version = "0.0.0")
local_path_override(
    module_name = "lib_b",
    path = "../lib_b",
)

bazel_dep(name = "lib_c", version = "0.0.0")
local_path_override(
    module_name = "lib_c",
    path = "../lib_c",
)

# Root module overrides the configurable target with lib_b's custom content.
# Extensions from lib_c are still applied on top of the override.
override_target(
    target = "@lib_a//:content",
    replacement = "@lib_b//:custom_content",
)
