module(
    name = "example_error_duplicate_override",
    version = "0.0.0",
)

bazel_dep(name = "lib_a", version = "0.0.0")
local_path_override(
    module_name = "lib_a",
    path = "../lib_a",
)

bazel_dep(name = "lib_b", version = "0.0.0")
local_path_override(
    module_name = "lib_b",
    path = "../lib_b",
)

# First override — valid.
override_target(
    target = "@lib_a//:content",
    replacement = "@lib_b//:custom_content",
)

# Second override for the same target — ERROR: duplicate.
override_target(
    target = "@lib_a//:content",
    replacement = "@lib_b//:custom_content",
)
