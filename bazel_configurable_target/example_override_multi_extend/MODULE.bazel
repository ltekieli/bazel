module(
    name = "example_override_multi_extend",
    version = "0.0.0",
)

bazel_dep(name = "lib_a", version = "0.0.0")
local_path_override(
    module_name = "lib_a",
    path = "../lib_a",
)

bazel_dep(name = "lib_b", version = "0.0.0")
local_path_override(
    module_name = "lib_b",
    path = "../lib_b",
)

bazel_dep(name = "lib_c", version = "0.0.0")
local_path_override(
    module_name = "lib_c",
    path = "../lib_c",
)

bazel_dep(name = "lib_d", version = "0.0.0")
local_path_override(
    module_name = "lib_d",
    path = "../lib_d",
)

# Override + multiple extensions.
# lib_b replaces the default; lib_c and lib_d extensions merge on top.
override_target(
    target = "@lib_a//:content",
    replacement = "@lib_b//:custom_content",
)
