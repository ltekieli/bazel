module(
    name = "example_override_only",
    version = "0.0.0",
)

bazel_dep(name = "lib_a", version = "0.0.0")
local_path_override(
    module_name = "lib_a",
    path = "../lib_a",
)

bazel_dep(name = "lib_b", version = "0.0.0")
local_path_override(
    module_name = "lib_b",
    path = "../lib_b",
)

# Override only, no extensions in the dependency graph.
override_target(
    target = "@lib_a//:content",
    replacement = "@lib_b//:custom_content",
)
